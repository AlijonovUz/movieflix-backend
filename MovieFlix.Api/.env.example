# Muhit turi (Development, Staging, Production)
ASPNETCORE_ENVIRONMENT=Development

# Ruxsat berilgan hostlar (* - barcha hostlar)
AllowedHosts=*

# Ma'lumotlar bazasiga ulanish qatori (SQLite yoki PostgreSQL)
ConnectionStrings__DefaultConnection=Data Source=movie.db

# JWT Sozlamalari
Jwt__SecretKey=
Jwt__Issuer=
Jwt__Audience=
Jwt__ExpiresInMinutes=120