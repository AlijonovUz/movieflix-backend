@baseUrl = http://localhost:5097

# 1. GENRES (Janrlar)

### 1.1 Barcha janrlarni olish (Pagination)
GET {{baseUrl}}/api/genres?pageNumber=1&pageSize=10
Accept: application/json

### 1.2 Qidiruv bilan olish (Search)
GET {{baseUrl}}/api/genres?search=jang
Accept: application/json

### 1.3 Bitta janrni ID bo'yicha olish
GET {{baseUrl}}/api/genres/1
Accept: application/json

### 1.4 Bitta janrni Slug bo'yicha olish
GET {{baseUrl}}/api/genres/jangari
Accept: application/json

### 1.5 Yangi janr yaratish (POST)
POST {{baseUrl}}/api/genres
Content-Type: application/json

{
  "name": "Jangari",
  "slug": ""
}

### 1.6 Janrni yangilash (PUT)
PUT {{baseUrl}}/api/genres/1
Content-Type: application/json

{
  "name": "Jangari Filmlar",
  "slug": "jangari-filmlar"
}

### 1.7 Janrni o'chirish
DELETE {{baseUrl}}/api/genres/1
Content-Type: application/json

# 2. COUNTRIES (Davlatlar)

### 2.1 Barcha davlatlarni olish (Pagination)
GET {{baseUrl}}/api/countries?pageNumber=1&pageSize=10
Accept: application/json

### 2.2 Yangi davlat yaratish
POST {{baseUrl}}/api/countries
Content-Type: application/json

{
  "name": "AQSH",
  "slug": ""
}

### 2.3 Davlatni o'chirish
DELETE {{baseUrl}}/api/countries/1
Content-Type: application/json


# 3. AGE LIMITS (Yosh chegaralari)

### 3.1 Barcha yosh chegaralarini olish
GET {{baseUrl}}/api/agelimits
Accept: application/json

### 3.2 Yosh chegarasi qo'shish: 0+ (Barchaga)
POST {{baseUrl}}/api/agelimits
Content-Type: application/json

{
  "age": 0
}

### 3.3 Yosh chegarasi qo'shish: 6+
POST {{baseUrl}}/api/agelimits
Content-Type: application/json

{
  "age": 6
}

### 3.4 Yosh chegarasi qo'shish: 12+
POST {{baseUrl}}/api/agelimits
Content-Type: application/json

{
  "age": 12
}

### 3.5 Yosh chegarasi qo'shish: 16+
POST {{baseUrl}}/api/agelimits
Content-Type: application/json

{
  "age": 16
}

### 3.6 Yosh chegarasi qo'shish: 18+ (Kattalar uchun)
POST {{baseUrl}}/api/agelimits
Content-Type: application/json

{
  "age": 18
}

### 3.7 Yosh chegarasini o'chirish
DELETE {{baseUrl}}/api/agelimits/1
Content-Type: application/json

